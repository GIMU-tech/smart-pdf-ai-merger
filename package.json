{
  "name": "pdf-ai-toolkit",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "main.cjs",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "server": "node server.cjs",
    "dev:all": "start cmd /k node server.cjs && vite --port=3000 --host=0.0.0.0",
    "build": "node node_modules/vite/bin/vite.js build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "sync": "powershell -NoProfile -ExecutionPolicy Bypass -File ./git-sync.ps1",
    "electron:start": "node node_modules/electron/cli.js .",
    "electron:build": "node node_modules/vite/bin/vite.js build && node node_modules/electron-packager/bin/electron-packager.js . \"PDF & AI Toolkit\" --platform=win32 --arch=x64 --out=release --overwrite --ignore=\"^/src($|/)|tsconfig\\.json|vite\\.config\\.ts|\\.git$\""
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@techstark/opencv-js": "^4.12.0-release.1",
    "@vitejs/plugin-react": "^5.0.4",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "diff": "^9.0.0",
    "express": "^5.2.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "multer": "^2.1.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.7.284",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "string-similarity": "^4.0.4",
    "tailwind-merge": "^3.6.0",
    "tesseract.js": "^7.0.0",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "electron": "^42.1.0",
    "electron-builder": "^26.8.1",
    "electron-packager": "^17.1.2",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
